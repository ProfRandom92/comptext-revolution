  "type": "module",
  "description": "MCP + REST server exposing all CompText tools",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "comptext-mcp": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc",
